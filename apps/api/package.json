{
  "name": "@crm-whatsapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/app.test.ts test/password.test.ts test/totp.test.ts test/message-status.test.ts test/normalize-message.test.ts",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/database/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/database/seed.ts",
    "set-password": "node --env-file-if-exists=../../.env --import tsx src/auth/set-password.ts",
    "enroll-mfa": "node --env-file-if-exists=../../.env --import tsx src/auth/enroll-mfa.ts",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx --test test/database.test.ts test/auth.integration.test.ts test/ingestion.integration.test.ts"
  },
  "dependencies": {
    "@types/qrcode": "1.5.6",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
